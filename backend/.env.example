DATABASE_URL="postgresql://eclospace:eclospace_dev@localhost:5432/eclospace?schema=public"
SESSION_SECRET="change-me-in-every-environment"
PORT=3000

# Origine autorisée par CORS pour le frontend en développement (Vite).
# Sans effet en production : le frontend compilé est servi par ce même
# serveur (même origine), voir docs/JOURNAL_TECHNIQUE.md.
FRONTEND_ORIGIN="http://localhost:5173"

# Mot de passe du compte administrateur initial (identifiant : admin), créé
# par le seed au tout premier déploiement. À définir avec une valeur forte de
# votre choix — sinon une valeur par défaut connue est utilisée. Une fois le
# mot de passe changé depuis l'interface, ce paramètre n'a plus aucun effet
# (les redéploiements ne réinitialisent jamais un mot de passe déjà modifié).
ADMIN_INITIAL_PASSWORD="ChangeMoiImmediatement!"

# Mot de passe maître de secours (« bris de glace »), réservé au compte
# passe-partout (admin). DÉSACTIVÉ par défaut : la fonctionnalité n'existe que
# si cette variable est définie. On n'y met JAMAIS le mot de passe en clair,
# mais son EMPREINTE argon2 (générée hors ligne). En cas de perte du mot de
# passe ou du second facteur du compte admin, ce mot de passe maître permet de
# s'y reconnecter — chaque usage est journalisé en priorité haute. À laisser
# vide si vous ne souhaitez pas ce mécanisme.
MASTER_PASSWORD_HASH=""

# Envoi d'e-mails (confirmations de compte, documents facture/relevé, alertes).
# Boîtes du domaine de la maison hébergées chez Hostinger (mail.hostinger.com).
# Valeurs Hostinger : SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465 (SSL) ou 587.
# SMTP_USER/SMTP_PASS = l'adresse complète d'une boîte du domaine et son mot de
# passe (le mot de passe se saisit DIRECTEMENT sur l'hébergement, jamais dans le
# dépôt). Tant que ces variables ne sont pas configurées : en développement
# l'e-mail est journalisé, en production l'envoi échoue explicitement
# (mail_not_configured). Détail : docs/JOURNAL_TECHNIQUE.md.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Adresse affichée en « De » : la boîte authentifiée du domaine (souvent = SMTP_USER).
SMTP_FROM=""
# Nom affiché par défaut de l'expéditeur.
SMTP_FROM_NAME="Éclosion Édition"
# Adresse recevant une copie invisible de chaque envoi (défaut : SMTP_FROM).
SMTP_ARCHIVE_TO=""

# URL publique de l'application, utilisée pour construire le lien de confirmation
# envoyé par e-mail. Optionnelle : à défaut, l'URL est déduite de la requête.
APP_BASE_URL=""

# Stockage des documents (GED).
# En PRODUCTION : renseigner les variables S3 ci-dessous (stockage objet
# durable, ex. Scaleway Object Storage région Paris) — les fichiers y sont
# conservés de façon pérenne. Dès que S3_BUCKET + les clés + (S3_ENDPOINT ou
# S3_REGION) sont définis, l'application stocke sur S3 automatiquement.
# En DÉVELOPPEMENT/TEST (variables S3 absentes) : repli sur le disque local
# (UPLOAD_DIR). ⚠️ Le disque d'un conteneur Scalingo est éphémère : ne jamais
# rester sur le disque local en production.
S3_ENDPOINT="https://s3.fr-par.scw.cloud"
S3_REGION="fr-par"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Style d'URL des objets. Scaleway fonctionne avec la valeur par défaut ("false").
# Passer à "true" seulement si le fournisseur exige le style "path".
S3_FORCE_PATH_STYLE="false"

# Dossier de stockage local, utilisé uniquement en développement/test (repli
# quand S3 n'est pas configuré).
UPLOAD_DIR="./uploads"

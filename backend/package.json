{
  "name": "eclospace-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --env-file=.env node_modules/.bin/tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "pretest": "node --env-file=.env.test node_modules/.bin/prisma migrate deploy && node --env-file=.env.test node_modules/.bin/tsx prisma/seed.ts",
    "test": "node --env-file=.env.test node_modules/.bin/vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "seed": "node --env-file=.env node_modules/.bin/tsx prisma/seed.ts",
    "seed:deploy": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.0.4",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "diff": "^9.0.0",
    "fastify": "^5.9.0",
    "fastify-plugin": "^5.0.1",
    "jimp": "^1.6.1",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "prisma": "^5.20.0",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.8.3",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "jszip": "^3.10.1",
    "s3rver": "^3.7.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.9"
  }
}
